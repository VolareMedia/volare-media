# Volare Media — redirects & basics

# Serve pages as UTF-8 (without this the server sends a bare text/html and
# browsers fell back to windows-1252, showing "Â·" for "·")
AddDefaultCharset UTF-8

# Old Zyrosite URLs (still in Google's index) → closest new page.
# Anchored with ^...$ so real .html files are never matched.
RedirectMatch 301 ^/voice-over-recording/?$      /services.html
RedirectMatch 301 ^/film-production/?$           /services.html
RedirectMatch 301 ^/marketing-videos/?$          /services.html
RedirectMatch 301 ^/music-video-production/?$    /services.html
RedirectMatch 301 ^/services/?$                  /services.html
RedirectMatch 301 ^/blog/?$                      /journal.html
RedirectMatch 301 ^/contact/?$                   /contact.html
RedirectMatch 301 ^/about/?$                     /about.html
RedirectMatch 301 ^/privacy-policy/?$            /privacy-policy.html
RedirectMatch 301 ^/terms-and-conditions/?$      /
# Old Zyrosite blog/service URLs flagged in Search Console (2026-10-07)
RedirectMatch 301 ^/digital-marketing/?$         /marketing-videos.html
RedirectMatch 301 ^/non-skippable-youtube-video-ad/?$  /never-make-a-video-to-make-a-video.html
RedirectMatch 301 ^/local-filmmakers-bring-powerful-mental-health-message-to-bcs-construction-community(-copy)?/?$  /tailgate-toolkit-61-stations.html
