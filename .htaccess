# Volare Media — redirects & basics

# Serve pages as UTF-8 (without this the server sends a bare text/html and
# browsers fell back to windows-1252, showing "Â·" for "·")
AddDefaultCharset UTF-8

# Old Zyrosite URLs (still in Google's index) → closest new page.
# Anchored with ^...$ so real .html files are never matched.
RedirectMatch 301 ^/voice-over-recording/?$      /services.html
RedirectMatch 301 ^/film-production/?$           /services.html
RedirectMatch 301 ^/marketing-videos/?$          /services.html
RedirectMatch 301 ^/music-video-production/?$    /services.html
RedirectMatch 301 ^/services/?$                  /services.html
RedirectMatch 301 ^/blog/?$                      /journal.html
RedirectMatch 301 ^/contact/?$                   /contact.html
RedirectMatch 301 ^/about/?$                     /about.html
RedirectMatch 301 ^/privacy-policy/?$            /privacy-policy.html
RedirectMatch 301 ^/terms-and-conditions/?$      /
# Old Zyrosite blog/service URLs flagged in Search Console (2026-10-07)
RedirectMatch 301 ^/digital-marketing/?$         /marketing-videos.html
RedirectMatch 301 ^/non-skippable-youtube-video-ad/?$  /never-make-a-video-to-make-a-video.html
RedirectMatch 301 ^/local-filmmakers-bring-powerful-mental-health-message-to-bcs-construction-community(-copy)?/?$  /tailgate-toolkit-61-stations.html

# ---- Added 2026-10-28 (site maintenance) ----

# One hostname: send bare volaremedia.net to www (canonical tags already say www).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^volaremedia\.net$ [NC]
RewriteRule ^(.*)$ https://www.volaremedia.net/$1 [R=301,L]
</IfModule>

# Branded 404 page.
ErrorDocument 404 /404.html

# Long browser caching for static assets. CSS/JS are versioned with ?v= so
# they can be cached for a year too; HTML stays uncached so edits show at once.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4|woff2|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
